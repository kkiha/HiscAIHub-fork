// AI 공유 허브 — Prisma 스키마
// 에이전트 단일 체계. 프롬프트·좋아요는 기획서 개정(2026-08-13)으로 제거했다.
// 저장=비공개(집계·알림 없음, 존재 여부만 조회), 후기=공개(작성자에게 알림).
// 부서 확산 지표는 AuditLog(action=agent_run, targetId=agentId, deptSnapshot)를 집계해 만든다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // [SQLITE] PostgreSQL 복귀 시: provider를 "postgresql"로 되돌린다.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  dept         String
  // [SQLITE] PostgreSQL 복귀 시: UserRole enum과 @default(user)로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  role         String    @default("user")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActiveAt DateTime?

  agents              Agent[]
  reviews             Review[]
  saves               Save[]
  reportsFiled        Report[]       @relation("Reporter")
  auditLogs           AuditLog[]
  usageLogs           UsageLog[]
  notificationsGot    Notification[] @relation("Recipient")
  notificationsCaused Notification[] @relation("Actor")

  @@index([email])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
}

model Agent {
  id          String  @id @default(cuid())
  name        String
  description String
  category    String
  // [SQLITE] PostgreSQL 복귀 시: ContentStatus enum과 @default(published)로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  status      String  @default("published")
  official    Boolean @default(false)
  runCount    Int     @default(0)

  // 실행 방식
  // [SQLITE] PostgreSQL 복귀 시: RunType enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  runType String
  trigger String // 언제 도는지 — "매일 오전 06:30 (평일)", "신규 티켓이 생성될 때마다"

  // 무슨 일을 하는가
  // [SQLITE] PostgreSQL 복귀 시: @db.Text를 복원한다.
  targetTask String // 이 에이전트가 맡는 업무 (도입 전 상황 포함)
  // [SQLITE] PostgreSQL 복귀 시: String[]으로 되돌린다. 읽기·쓰기는 src/lib/json-list.ts 경유.
  tasks      Json   @default("[]") // 에이전트가 스스로 하는 일 (순서 있는 목록)
  // [SQLITE] PostgreSQL 복귀 시: String[]으로 되돌린다. 읽기·쓰기는 src/lib/json-list.ts 경유.
  tools      Json   @default("[]") // 연결되는 도구·데이터

  // 효과
  // [SQLITE] PostgreSQL 복귀 시: @db.Text를 복원한다.
  effect     String
  // [SQLITE] PostgreSQL 복귀 시: TimeBand enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  timeBefore String? // 도입 전 1회 소요시간
  // [SQLITE] PostgreSQL 복귀 시: TimeBand enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  timeAfter  String? // 도입 후 1회 소요시간

  // 사용 방법
  // [SQLITE] PostgreSQL 복귀 시: String[]으로 되돌린다. 읽기·쓰기는 src/lib/json-list.ts 경유.
  prerequisites Json    @default("[]") // 미리 준비할 것
  // [SQLITE] PostgreSQL 복귀 시: String[]으로 되돌린다. 읽기·쓰기는 src/lib/json-list.ts 경유.
  howToUse      Json    @default("[]") // 사용 순서
  // [SQLITE] PostgreSQL 복귀 시: @db.Text를 복원한다.
  instructions  String // 에이전트 정의 (복사 대상)
  linkUrl       String? // 사내 Git 저장소 등 바로가기

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outputs       AgentOutput[]
  reviews       Review[]
  saves         Save[]
  reports       Report[]
  notifications Notification[]

  @@index([authorId])
  @@index([category])
  @@index([status])
}

// 실제 산출물 스크린샷. "말로만 좋다"가 아니라 결과물을 보여주는 자리.
model AgentOutput {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // [SQLITE] PostgreSQL 복귀 시: @db.Text를 복원한다.
  src     String // 이미지 URL 또는 data URI
  caption String
  order   Int    @default(0)

  @@index([agentId])
}

// 활용 후기 — 단순 댓글이 아니라 "어디에 썼는지 + 효과 + 도입 전/후 소요시간".
// 공개이며 작성자에게 알림이 간다. 남긴 시간 구간은 전사 절감 시간 집계에 반영된다.
model Review {
  id         String   @id @default(cuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  useCase    String? // 어떤 업무에 썼는지
  // [SQLITE] PostgreSQL 복귀 시: @db.Text를 복원한다.
  effect     String // 어떤 효과가 있었는지 (필수)
  // [SQLITE] PostgreSQL 복귀 시: TimeBand enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  timeBefore String?
  // [SQLITE] PostgreSQL 복귀 시: TimeBand enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  timeAfter  String?
  createdAt  DateTime @default(now())

  @@index([agentId])
  @@index([userId])
}

// 비공개: 집계·알림 없음. 존재 여부만 조회(사용자 본인만 열람).
model Save {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, agentId])
  @@index([agentId])
}

model Notification {
  id          String   @id @default(cuid())
  // [SQLITE] PostgreSQL 복귀 시: NotificationType enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  type        String
  recipientId String
  recipient   User     @relation("Recipient", fields: [recipientId], references: [id])
  actorId     String
  actor       User     @relation("Actor", fields: [actorId], references: [id])
  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reviewText  String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId])
}

model Report {
  id         String    @id @default(cuid())
  reason     String
  reporterId String
  reporter   User      @relation("Reporter", fields: [reporterId], references: [id])
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // [SQLITE] PostgreSQL 복귀 시: ReportStatus enum과 @default(pending)로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  status     String    @default("pending")
  // [SQLITE] PostgreSQL 복귀 시: ReportAction enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  action     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([agentId])
  @@index([status])
}

// deptSnapshot = 행위 시점의 사용자 부서. 부서 이동·조직개편이 있어도 과거 확산 지표가
// 흔들리지 않도록 User.dept를 조인하지 않고 그때 값을 그대로 박아 둔다.
model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  deptSnapshot String
  // [SQLITE] PostgreSQL 복귀 시: AuditAction enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  action       String
  targetType   String?
  targetId     String? // agent_run/agent_copy의 경우 Agent.id — 팀 × 에이전트 확산 행렬의 원천
  targetLabel  String?
  fileCount    Int      @default(0)
  // [SQLITE] PostgreSQL 복귀 시: AuditStatus enum과 @default(success)로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  status       String   @default("success")
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetId])
}

// Claude 호출량·비용 로그 (사용량·비용 집계 원천).
model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  feature   String // "agent_generate"
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costUsd   Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([feature])
}

// ---------- 구독 현황 (외부 데이터 · 매월 수동 업데이트) ----------
// 조직 역량개발비 지원 내역 기준. 플랫폼이 자동 수집하지 않으므로 월 스냅샷으로 적재하고,
// 대시보드는 가장 최근 스냅샷을 읽는다. 과거 월도 남겨 추이를 볼 수 있게 한다.
model SubscriptionSnapshot {
  id     String @id @default(cuid())
  period String @unique // "2026-05"
  label  String // "26년 5월"
  // [SQLITE] PostgreSQL 복귀 시: @db.Text를 복원한다.
  note   String // 집계 기준·제외 대상·월 환산 방식

  totalUsers      Int
  totalAccounts   Int
  totalCostManwon Int

  rows      SubscriptionRow[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model SubscriptionRow {
  id         String               @id @default(cuid())
  snapshotId String
  snapshot   SubscriptionSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  // [SQLITE] PostgreSQL 복귀 시: SubScope enum으로 되돌린다. 허용값은 src/lib/domain-values.ts 참조.
  scope      String
  name       String // 부문/실 또는 팀 이름
  division   String? // scope=team일 때 소속 부문
  users      Int
  costManwon Int
  tools      Json // { "ChatGPT": 30, "Gemini": 22, ... }
  order      Int                  @default(0)

  @@unique([snapshotId, scope, name])
  @@index([snapshotId])
}

// 운영 설정 (카테고리는 Category 모델, 그 외는 key-value).
model Setting {
  key   String @id
  value Json
}
