# local-sqlite-demo 브랜치 전용 예시입니다.
# 이 파일을 .env.local로 복사해 사용하세요. .env.local은 커밋하지 않습니다.

# Prisma의 file 경로는 prisma/schema.prisma 기준으로 해석됩니다.
DATABASE_URL="file:./dev.db"

# 로컬 임직원 로그인
AUTH_SECRET="local-demo-employee-session-secret-change-me"
ALLOWED_EMAIL_DOMAIN="hanwha.com"
EMPLOYEE_DEV_PASSWORD="local-demo"

# 로컬 관리자 로그인
ADMIN_ID="admin"
ADMIN_PW="admin"
ADMIN_SECRET="local-demo-admin-session-secret-change-me"

# 선택 사항: 비워 두면 앱과 대시보드는 정상 동작하고 AI 생성 API만 503으로 비활성화됩니다.
ANTHROPIC_API_KEY=""
