// AI 공유 허브 — Prisma 스키마
// 저장=비공개(집계·알림 없음, 존재 여부만 조회).
// Prompt/Agent에 대한 저장·댓글·신고는 각각 promptId/agentId 중 하나만 채우는
// nullable dual-FK 패턴 사용 (둘 다 null이거나 둘 다 set되지 않는 것은 애플리케이션에서 보장).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  mod
  user
}

enum ContentStatus {
  published
  hidden
  flagged
}

enum ReportStatus {
  pending
  resolved
}

enum ReportAction {
  keep
  hide
  delete
}

enum NotificationType {
  comment
}

enum AuditAction {
  prompt_generate
  prompt_create
  prompt_update
  prompt_delete
  prompt_run
  prompt_copy
  agent_generate
  agent_create
  agent_update
  agent_delete
  agent_run
}

enum AuditStatus {
  success
  failure
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  dept         String
  role         UserRole  @default(user)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActiveAt DateTime?

  prompts              Prompt[]
  agents               Agent[]
  comments             Comment[]
  saves                Save[]
  reportsFiled         Report[]       @relation("Reporter")
  auditLogs            AuditLog[]
  usageLogs            UsageLog[]
  notificationsGot     Notification[] @relation("Recipient")
  notificationsCaused  Notification[] @relation("Actor")

  @@index([email])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
}

model Prompt {
  id          String        @id @default(cuid())
  title       String
  description String
  body        String        @db.Text
  category    String
  status      ContentStatus @default(published)
  official    Boolean       @default(false)
  copyCount   Int           @default(0)
  runCount    Int           @default(0)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  comments      Comment[]
  saves         Save[]
  reports       Report[]
  notifications Notification[]

  @@index([authorId])
  @@index([category])
  @@index([status])
}

model Agent {
  id           String        @id @default(cuid())
  name         String
  description  String
  instructions String        @db.Text
  exampleTasks String[]
  category     String
  status       ContentStatus @default(published)
  official     Boolean       @default(false)
  runCount     Int           @default(0)
  authorId     String
  author       User          @relation(fields: [authorId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  comments      Comment[]
  saves         Save[]
  reports       Report[]
  notifications Notification[]

  @@index([authorId])
  @@index([category])
  @@index([status])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  promptId  String?
  prompt    Prompt?  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([promptId])
  @@index([agentId])
}

// 비공개: 집계·알림 없음. 존재 여부만 조회(사용자 본인만 열람).
model Save {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  promptId  String?
  prompt    Prompt?  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
  @@unique([userId, agentId])
  @@index([promptId])
  @@index([agentId])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id])
  actorId     String
  actor       User             @relation("Actor", fields: [actorId], references: [id])
  promptId    String?
  prompt      Prompt?          @relation(fields: [promptId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  commentText String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId])
}

model Report {
  id         String        @id @default(cuid())
  reason     String
  reporterId String
  reporter   User          @relation("Reporter", fields: [reporterId], references: [id])
  promptId   String?
  prompt     Prompt?       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status     ReportStatus  @default(pending)
  action     ReportAction?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  @@index([promptId])
  @@index([agentId])
  @@index([status])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  action      AuditAction
  targetType  String?
  targetId    String?
  targetLabel String?
  fileCount   Int         @default(0)
  status      AuditStatus @default(success)
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Claude 호출량·비용 로그 (관리자 사용량·비용 집계 원천).
model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  feature   String // "prompt_generate" | "agent_generate"
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costUsd   Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([feature])
}

// 관리자 설정 (카테고리 관리는 Category 모델 사용, 그 외 설정은 key-value).
model Setting {
  key   String @id
  value Json
}
